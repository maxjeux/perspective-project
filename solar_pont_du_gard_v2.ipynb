      "source": [
        "# 🌞 Solar Panel Mapping — Communauté de Communes du Pont du Gard\n",
        "AI-based detection of solar panels using IGN aerial imagery (20cm/pixel) and DeepLabV3 segmentation.\n",
        "\n",
        "**Model:** PV-Segmentation-deeplabv3 (Kleebaue et al. 2023) — F1: 95.27%, IoU: 91.04%\n",
        "\n",
        "**Pipeline:** IGN WMTS tiles (zoom 19) → DeepLabV3 inference → Solar score per tile → Heatmap\n",
        "\n",
        "> ⚠️ Always run **SECTION 1 — SETUP** first at the start of each session.\n",
        "> The model loads from Google Drive — no re-download needed."
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "## SECTION 1 — SETUP\n",
        "Run this at the start of every session."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 1.1 — Install dependencies\n",
        "!pip install torch torchvision requests pillow tqdm matplotlib pandas -q\n",
        "print('✅ Dependencies ready')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 1.2 — Imports\n",
        "import os, math, requests, torch\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "from torchvision import transforms\n",
        "from PIL import Image\n",
        "from io import BytesIO\n",
        "from tqdm import tqdm\n",
        "print('✅ Imports OK')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 1.3 — Check GPU\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print('Device:', device)\n",
        "if torch.cuda.is_available():\n",
        "    print('GPU:', torch.cuda.get_device_name(0))\n",
        "else:\n",
        "    print('⚠️ No GPU — enable it in Runtime > Change runtime type')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 1.4 — Mount Google Drive and load model\n",
        "# Model file: solar-project/PV-Segmentation-deeplabv3.pt\n",
        "# Share the solar-project folder with your collaborator on Google Drive\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "MODEL_PATH = '/content/drive/MyDrive/solar-project/PV-Segmentation-deeplabv3.pt'\n",
        "\n",
        "if not os.path.exists(MODEL_PATH):\n",
        "    print('❌ Model not found — downloading from Fraunhofer...')\n",
        "    os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)\n",
        "    url = 'https://owncloud.fraunhofer.de/index.php/s/FdjVUCS8fgocAxz/download?path=%2F&files=PV-Segmentation-deeplabv3.pt'\n",
        "    r = requests.get(url)\n",
        "    with open(MODEL_PATH, 'wb') as f:\n",
        "        f.write(r.content)\n",
        "    print('✅ Model downloaded and saved to Drive')\n",
        "\n",
        "model = torch.load(MODEL_PATH, map_location=device, weights_only=False)\n",
        "model = model.to(device)\n",
        "model.eval()\n",
        "print('✅ Model loaded from Drive on', device)"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 1.5 — Core functions\n",
        "\n",
        "# Parameters (validated through testing)\n",
        "ZOOM = 19           # Best zoom level for residential panels\n",
        "IMG_SIZE = 500      # Required input size for the model\n",
        "THRESHOLD = 0.5     # Detection threshold\n",
        "\n",
        "TRANSFORM = transforms.Compose([\n",
        "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
        "    transforms.ToTensor()\n",
        "])\n",
        "\n",
        "def lon_lat_to_tile(lon, lat, zoom):\n",
        "    \"\"\"Convert lon/lat coordinates to WMTS tile col/row\"\"\"\n",
        "    n = 2 ** zoom\n",
        "    x = int((lon + 180) / 360 * n)\n",
        "    y = int((1 - math.log(math.tan(math.radians(lat)) + 1/math.cos(math.radians(lat))) / math.pi) / 2 * n)\n",
        "    return x, y\n",
        "\n",
        "def tile_to_lon_lat(col, row, zoom):\n",
        "    \"\"\"Convert tile col/row back to lon/lat (top-left corner)\"\"\"\n",
        "    n = 2 ** zoom\n",
        "    lon = col / n * 360 - 180\n",
        "    lat = math.degrees(math.atan(math.sinh(math.pi * (1 - 2 * row / n))))\n",
        "    return lon, lat\n",
        "\n",
        "def get_ign_tile(col, row, zoom=ZOOM):\n",
        "    \"\"\"Fetch one IGN BD ORTHO aerial tile (20cm/pixel)\"\"\"\n",
        "    url = (\n",
        "        f'https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0'\n",
        "        f'&LAYER=HR.ORTHOIMAGERY.ORTHOPHOTOS&STYLE=normal&TILEMATRIXSET=PM'\n",
        "        f'&TILEMATRIX={zoom}&TILEROW={row}&TILECOL={col}&FORMAT=image/jpeg'\n",
        "    )\n",
        "    try:\n",
        "        r = requests.get(url, timeout=15)\n",
        "        if 'image' in r.headers.get('Content-Type', ''):\n",
        "            return Image.open(BytesIO(r.content)).convert('RGB')\n",
        "    except:\n",
        "        pass\n",
        "    return None\n",
        "\n",
        "def detect_solar(img, threshold=THRESHOLD):\n",
        "    \"\"\"Run model on a PIL image. Returns (score_percent, binary_mask)\"\"\"\n",
        "    tensor = TRANSFORM(img).unsqueeze(0).to(device)\n",
        "    with torch.no_grad():\n",
        "        output = model(tensor)\n",
        "    raw = torch.sigmoid(output['out'].cpu()).squeeze().numpy()\n",
        "    mask = (raw >= threshold).astype(int)\n",
        "    score = mask.mean() * 100\n",
        "    return score, mask\n",
        "\n",
        "print('✅ All functions ready — SETUP complete!')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "## SECTION 2 — TEST SINGLE TILE\n",
        "Verify the pipeline works on one tile before running the full dataset."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 2.1 — Fetch a test tile (Remoulins, Pont du Gard)\n",
        "LON_TEST, LAT_TEST = 4.5685, 43.9398\n",
        "col, row = lon_lat_to_tile(LON_TEST, LAT_TEST, ZOOM)\n",
        "print(f'Tile: zoom={ZOOM}, col={col}, row={row}')\n",
        "\n",
        "img = get_ign_tile(col, row)\n",
        "if img:\n",
        "    print(f'✅ Tile fetched: {img.size}')\n",
        "    plt.imshow(img)\n",
        "    plt.title('IGN tile — Remoulins')\n",
        "    plt.axis('off')\n",
        "    plt.show()\n",
        "else:\n",
        "    print('❌ Failed to fetch tile')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 2.2 — Run detection on test tile\n",
        "score, mask = detect_solar(img)\n",
        "print(f'Solar score: {score:.2f}%')\n",
        "\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))\n",
        "ax1.imshow(img)\n",
        "ax1.set_title('IGN Image')\n",
        "ax1.axis('off')\n",
        "ax2.imshow(img.resize((IMG_SIZE, IMG_SIZE)))\n",
        "ax2.imshow(mask, cmap='Reds', alpha=0.6)\n",
        "ax2.set_title(f'Detection (score: {score:.1f}%)')\n",
        "ax2.axis('off')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "## SECTION 3 — FULL PIPELINE\n",
        "Process all tiles over the Pont du Gard territory.\n",
        "\n",
        "**Estimated tiles at zoom 19:** ~350,000 (full territory)\n",
        "\n",
        "**Tip:** Run on a smaller bbox first to validate, then expand to full territory.\n",
        "\n",
        "> ⚠️ Make sure GPU is enabled. Results are saved to Drive after each column — safe to interrupt and resume."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 3.1 — Define bounding box\n",
        "# Set TEST_MODE = True for a small run (~200 tiles), False for full territory\n",
        "TEST_MODE = True\n",
        "\n",
        "if TEST_MODE:\n",
        "    # Small test zone — Remoulins area\n",
        "    BBOX = {'lon_min': 4.555, 'lon_max': 4.585, 'lat_min': 43.930, 'lat_max': 43.950}\n",
        "else:\n",
        "    # Full Pont du Gard CC territory\n",
        "    BBOX = {'lon_min': 4.40, 'lon_max': 4.65, 'lat_min': 43.88, 'lat_max': 44.02}\n",
        "\n",
        "col_min, row_max = lon_lat_to_tile(BBOX['lon_min'], BBOX['lat_min'], ZOOM)\n",
        "col_max, row_min = lon_lat_to_tile(BBOX['lon_max'], BBOX['lat_max'], ZOOM)\n",
        "\n",
        "total = (col_max - col_min) * (row_max - row_min)\n",
        "print(f'Bounding box: {BBOX}')\n",
        "print(f'Tile range: cols {col_min}→{col_max}, rows {row_min}→{row_max}')\n",
        "print(f'Total tiles: ~{total:,}')\n",
        "print(f'Estimated time on GPU (1it/s): ~{total/60:.0f} minutes')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 3.2 — Run pipeline with checkpoint (resumes if interrupted)\n",
        "RESULTS_PATH = '/content/drive/MyDrive/solar-project/results.csv'\n",
        "\n",
        "# Load existing results if any\n",
        "if os.path.exists(RESULTS_PATH):\n",
        "    df_existing = pd.read_csv(RESULTS_PATH)\n",
        "    done = set(zip(df_existing['col'].astype(int), df_existing['row'].astype(int)))\n",
        "    print(f'Resuming — {len(done)} tiles already processed')\n",
        "else:\n",
        "    df_existing = pd.DataFrame()\n",
        "    done = set()\n",
        "    print('Starting fresh')\n",
        "\n",
        "results = []\n",
        "errors = 0\n",
        "\n",
        "for c in tqdm(range(col_min, col_max), desc='Processing'):\n",
        "    for r in range(row_min, row_max):\n",
        "        if (c, r) in done:\n",
        "            continue\n",
        "        try:\n",
        "            img_tile = get_ign_tile(c, r)\n",
        "            if img_tile is None:\n",
        "                continue\n",
        "            score, _ = detect_solar(img_tile)\n",
        "            lon, lat = tile_to_lon_lat(c, r, ZOOM)\n",
        "            results.append({'col': c, 'row': r, 'lon': lon, 'lat': lat, 'score': score})\n",
        "        except Exception as e:\n",
        "            errors += 1\n",
        "            continue\n",
        "\n",
        "    # Save checkpoint every column\n",
        "    if results:\n",
        "        df_new = pd.DataFrame(results)\n",
        "        df_all = pd.concat([df_existing, df_new], ignore_index=True)\n",
        "        df_all.to_csv(RESULTS_PATH, index=False)\n",
        "        df_existing = df_all\n",
        "        done.update([(int(r['col']), int(r['row'])) for r in results])\n",
        "        results = []\n",
        "\n",
        "print(f'\\n✅ Done! Total processed: {len(df_existing):,} tiles, Errors: {errors}')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
